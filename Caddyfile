{
	# HTTP/3 выключен сознательно. Caddy включает его по умолчанию и добавляет к каждому
	# ответу заголовок «Alt-Svc: h3=":443"; ma=2592000», то есть на месяц обещает браузеру
	# QUIC на UDP/443. Обещание невыполнимо: в docker-compose.prod.yml проброшен «443:443»,
	# а это в Docker только TCP — UDP наружу не выходит вовсе. Браузер честно пробует QUIC,
	# упирается в тишину и уходит на TCP, и так на каждом визите месяц подряд.
	#
	# Просто добавить «443:443/udp» — хуже: QUIC в России и так режется ТСПУ, а поверх VPN
	# это UDP внутри UDP с урезанным MTU, то есть ровно тот трафик, который теряется первым.
	# Аудитория магазина сидит в РФ и половина — через VPN, поэтому берём предсказуемый
	# HTTP/2 поверх TCP: он проверен и отвечает 200 из любой страны.
	servers {
		protocols h1 h2
	}
}

omnia-workshop.ru {
	# Заголовки безопасности. Ставятся здесь, а не в приложении: Caddy — единственная точка,
	# через которую наружу выходит всё, включая админку Payload и статику.
	header {
		# Год HTTPS без возможности откатиться на http. Без includeSubDomains и preload
		# сознательно: и то и другое трудно отменить, а поддоменов у магазина пока нет —
		# добавить их в HSTS можно будет, когда они появятся и точно будут под TLS.
		Strict-Transport-Security "max-age=31536000"

		# Браузер обязан верить заявленному Content-Type. Иначе загруженный в админку файл
		# можно подсунуть так, чтобы он выполнился как скрипт.
		X-Content-Type-Options "nosniff"

		# Наружу уходит только origin, а не полный адрес страницы: иначе в чужие логи
		# попадали бы адреса вроде /checkout/success?orderId=123.
		Referrer-Policy "strict-origin-when-cross-origin"

		# Сайт нельзя встроить во фрейм на чужом домене — защита от кликджекинга поверх
		# формы заказа. SAMEORIGIN, а не DENY: свои страницы фреймить себя вправе.
		X-Frame-Options "SAMEORIGIN"

		# Камера и микрофон не нужны ни одной странице. Геолокацию не трогаем — её может
		# спросить карта пунктов выдачи.
		Permissions-Policy "camera=(), microphone=()"

		# Версию сервера наружу не отдаём — меньше подсказок о том, что и какой версии крутится.
		-Server
	}

	reverse_proxy app:3000
}
