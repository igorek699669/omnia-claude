# Скопируйте в .env.local и заполните реальными значениями. .env.local в git не попадает.

# Postgres (Better Auth хранит там users/sessions/verification в схеме public;
# Payload хранит свои таблицы в отдельной схеме payload — см. payload/payload.config.ts)
DATABASE_URL=postgres://user:password@localhost:5432/omnia

# Секрет для подписи сессий Better Auth — сгенерировать: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Адрес, на котором крутится приложение
BETTER_AUTH_URL=http://localhost:3000

# Секрет Payload CMS (шифрование сессий админки/сериализация) — сгенерировать так же: openssl rand -base64 32
PAYLOAD_SECRET=

# SMS.ru — подтверждение телефона входящим звонком (callcheck). api_id берётся в личном
# кабинете https://sms.ru/my/settings. Без него вход по телефону не работает совсем —
# ни локально, ни на проде: номер, на который звонить, выдаёт SMS.ru.
# SMS не отправляются: операторы отклоняют их без регистрации буквенного отправителя.
SMS_RU_API_ID=

# SMTP для письма продавцу об оплаченном заказе (временная замена CRM)
SMTP_HOST=
SMTP_PORT=587
# true для порта 465, false для 587/25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Omnia <noreply@omnia.ru>"
# Куда падают письма о новых оплаченных заказах. Пусто — на CONTACT_EMAIL из
# src/shared/lib/contacts.ts (omniaworkshop@yandex.ru).
ORDER_NOTIFY_EMAIL=

# ЮKassa — https://yookassa.ru/my/shop-settings/testing (тестовый магазин) или
# https://yookassa.ru/my/merchant/integration/api-keys (боевые ключи)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Тестовый магазин ЮKassa — для товаров с чекбоксом «тестовая оплата» (Payload → Товары →
# Тестовый режим). Заказ с таким товаром оплачивается этими ключами: путь боевой, деньги
# не списываются. Пусто — товар с чекбоксом просто не оформится, остальные не затронуты.
# Локально это те же ключи, что и в YOOKASSA_SHOP_ID/YOOKASSA_SECRET_KEY (магазин на деве и
# так тестовый); на прод они зашиты в .github/workflows/deploy.yml.
YOOKASSA_TEST_SHOP_ID=
YOOKASSA_TEST_SECRET_KEY=

# СДЭК API v2 — https://apidoc.cdek.ru/. Локально — тестовый контур api.edu.cdek.ru; боевой
# https://api.cdek.ru/v2 зашит в деплой (.github/workflows/deploy.yml) и локально не нужен.
# CDEK_ACCOUNT/CDEK_SECURE_PASSWORD для тестового контура — взять на apidoc.cdek.ru в разделе
# «Тестовый режим», либо создать свой ключ в личном кабинете lk.cdek.ru/integration (он тоже
# работает против api.edu.cdek.ru — отдельного договора для теста не нужно).
CDEK_API_URL=https://api.edu.cdek.ru/v2
CDEK_ACCOUNT=
CDEK_SECURE_PASSWORD=
# Код ПВЗ СДЭК, куда продавец сам привозит груз (оба используемых тарифа — «от склада»).
# Пусто — СДЭК подберёт пункт в городе отправителя (Брянск) сам. На тестовом контуре так
# и оставить: боевой пункт мастерской — BRK16, он зашит в деплой и на edu не существует.
CDEK_SHIPMENT_POINT=

# Подсказки и сверка адресов курьерской доставки (ДаData, поверх госреестра ГАР).
# Токен из личного кабинета dadata.ru, вкладка «API-ключи» — нужен именно ключ подсказок.
# Без него поле адреса остаётся обычным вводом, а сверка дома на чекауте не выполняется.
DADATA_API_KEY=

# Яндекс.Карты JS API v3 — бесплатный self-service ключ на developer.tech.yandex.ru
# (раздел «JavaScript API и HTTP Геокодер»). NEXT_PUBLIC_* — ключ уходит в браузер,
# это нормально для JS API карт (он ограничивается по домену в кабинете, не секрет).
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# Яндекс.Метрика — номер счётчика. Значение по умолчанию зашито в
# src/shared/lib/metrika.ts (номер не секрет, он виден в исходниках страницы).
# Переменная нужна, чтобы счётчик можно было выключить: пустая строка отключает его
# целиком — так сделано в E2E, чтобы прогоны не подмешивались к живой статистике.
NEXT_PUBLIC_YANDEX_METRIKA_ID=
